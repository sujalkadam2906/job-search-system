# Copy to .env and fill in. Never commit .env.
# Pick ONE provider for both stages (anthropic | gemini | groq | openai-compatible | ollama)
LLM_PROVIDER=gemini

# Only the key for your chosen provider is needed
GEMINI_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GROQ_API_KEY=your-groq-api-key

# Model ids: check your provider's current model list before use
SCREEN_MODEL=your-cheap-model-id
DRAFT_MODEL=your-better-model-id

# Email digest (Gmail: use an App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
MAIL_TO=you@example.com
